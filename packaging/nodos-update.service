[Unit]
Description=NodOS automatic update (opt-in, see docs/installation)
Documentation=https://github.com/valerisn/NodOS
After=network-online.target
Wants=network-online.target

# This unit is installed but does nothing until you run:
#   sudo nodos update --auto on --yes
# which enables nodos-update.timer. Read the warning that command prints first.

[Service]
Type=oneshot
# Runs as root on purpose: it replaces /usr/local/bin/nodos and restarts
# nodos.service. Everything it downloads is checked against the maintainers'
# signature first, and a version that does not come up healthy is rolled back.
ExecStart=/usr/local/bin/nodos update --auto-run --config /etc/nodos/nodos.conf

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /var/lib/nodos
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
