[Unit]
Description=NodOS automatic update (opt-in, see docs/installation)
Documentation=https://github.com/valerisn/NodOS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nodos update --auto-run --config /etc/nodos/nodos.conf

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /var/lib/nodos-update
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
